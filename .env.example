# Local development values. In AWS these come from Secrets Manager.
DATABASE_URL=postgres://promise:promise@localhost:5432/promise
DATABASE_SSL=false
NEXTAUTH_URL=http://localhost:3000
# Required. Any long random string, e.g. output of: openssl rand -base64 32
NEXTAUTH_SECRET=
# Optional locally. Without them the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional locally. Without it, sign-in links are printed to the server log.
EMAIL_SERVER=
EMAIL_FROM=Promise Card <hello@promisecard.store>
